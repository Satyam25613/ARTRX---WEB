# Current public domain, supplied in the project brief.
NEXT_PUBLIC_SITE_URL=https://artrx.co
NEXT_PUBLIC_SITE_INDEXABLE=false

# Contact delivery is disabled by default. Automated tests may explicitly set
# CONTACT_DELIVERY_MODE=mock; mock submissions are never saved or emailed.
CONTACT_DELIVERY_MODE=disabled
CONTACT_LIVE_DELIVERY_APPROVED=false

# Live Resend delivery requires a confirmed recipient, approved sender identity,
# verified sending domain, and explicit client approval. Never test live email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=
